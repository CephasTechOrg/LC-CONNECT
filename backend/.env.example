APP_NAME=LC Connect API
ENVIRONMENT=development
API_V1_PREFIX=/api/v1

# ── Database (required) ───────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/lc_connect_db

# ── Supabase Auth — FastAPI verifies mobile tokens (required) ───────
# Project URL — Dashboard → Project Settings → API → Project URL
SUPABASE_URL=https://YOURPROJECT.supabase.co

# JWT secret — Dashboard → Project Settings → API → JWT Secret
# Required for local Supabase / HS256 tokens. Production RS256 can use JWKS from SUPABASE_URL alone.
SUPABASE_JWT_SECRET=

# Almost always leave as "authenticated" (Supabase default access-token audience)
SUPABASE_JWT_AUDIENCE=authenticated

# "Send Email" Auth Hook secret — Dashboard → Authentication → Hooks → Send Email → enable →
# copy the generated secret here (starts with "whsec_"). Routes EVERY Supabase auth email
# (signup, recovery, invite, ...) — including the mobile app's direct calls — through LC
# Connect's own branded templates instead of Supabase's own mailer. See
# docs/getting-started/send_email_hook.md for the full setup walkthrough. Unset means the hook
# endpoint refuses all requests rather than processing something unverifiable.
SUPABASE_SEND_EMAIL_HOOK_SECRET=

# Campus signup policy (comma-separated domains)
ALLOWED_EMAIL_DOMAINS=students.livingstone.edu,livingstone.edu

# ⚠️  LOCAL DEVELOPMENT ONLY — NEVER SET THIS IN PRODUCTION / RENDER.
# The app REFUSES TO START (pydantic ValidationError) if this is non-empty while
# ENVIRONMENT=production. Deliberately left blank here so copying this file to a production
# dashboard can never break the deploy.
#
# Non-Livingstone emails allowed to sign in locally. Each entry is `email` (uses
# DEV_TEST_EMAIL_DEFAULT_ROLE) or `email:role` to pin a role — e.g. `prof@gmail.com:staff`.
# Example (local .env only):  DEV_TEST_EMAILS=you@gmail.com,teammate@gmail.com:staff
DEV_TEST_EMAILS=
DEV_TEST_EMAIL_DEFAULT_ROLE=student

# ── Legacy custom auth (rollback window only) ─────────────────────
# Set false after all clients use Supabase Auth. JWT_SECRET_KEY only needed while true.
AUTH_LEGACY_ENABLED=false  # off post-migration (app uses Supabase Auth); true only for emergency rollback
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:8081,http://127.0.0.1:3000,http://127.0.0.1:3001,http://127.0.0.1:8081

# ── Invite redirect targets (admin + employer portals) ────────────
# Where a Supabase invite email's confirmation link sends the invitee. Both portals share one
# Supabase project but are separate Next.js apps — without these, every invite (admin AND
# employer) falls back to the Supabase dashboard's single shared default Site URL, which can only
# be correct for one of them. Each app must have a matching `/accept-invite` page.
# employer-portal runs on port 3001 locally (see employer-portal/package.json) so both apps can
# run side-by-side during local testing.
ADMIN_PORTAL_URL=http://localhost:3000
EMPLOYER_PORTAL_URL=http://localhost:3001

# ── Supabase Storage (profile images — not required for login) ──────
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PROFILE_BUCKET=profile-images
MAX_PROFILE_IMAGE_MB=5
MAX_REQUEST_BODY_MB=12  # hard cap on any request body (≥ image cap; rejects oversized uploads at the edge)

# ── Limits & per-user abuse rate limits ───────────────────────────
# Global hard cap on group members (a group can never exceed this).
GROUP_MAX_MEMBERS=500
# Per-user, per-day caps on authenticated actions (login limits live in Supabase Auth).
RATE_LIMIT_CONNECTION_REQUESTS_PER_DAY=50
RATE_LIMIT_GROUP_CREATES_PER_DAY=5
RATE_LIMIT_AVATAR_UPLOADS_PER_DAY=10
RATE_LIMIT_REPORTS_PER_DAY=20
RATE_LIMIT_GROUP_INVITES_PER_DAY=200

# Verified staff may author campus posts (updates/opportunities). Admins always can.
# Urgent alerts remain admin-only regardless of this flag.
STAFF_PUBLISHING_ENABLED=true

# Verified staff may message any active user without a connection (and be messaged back).
STAFF_MESSAGING_ENABLED=true
RATE_LIMIT_STAFF_THREADS_PER_DAY=200
RATE_LIMIT_RECIPIENT_SEARCHES_PER_MINUTE=60
RATE_LIMIT_CAMPUS_POST_CREATES_PER_DAY=30
RATE_LIMIT_CAMPUS_POST_PUBLISHES_PER_DAY=20

# ── Email (Supabase sends auth emails; these are for legacy OTP only) ─
EMAIL_PROVIDER=auto
RESEND_API_KEY=
RESEND_FROM_EMAIL=LC Connect <noreply@yourdomain.com>
RESEND_REPLY_TO=support@yourdomain.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=LC Connect <your-gmail@gmail.com>
SMTP_TLS=true
