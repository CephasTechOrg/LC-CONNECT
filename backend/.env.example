APP_NAME=LC Connect API
ENVIRONMENT=development
API_V1_PREFIX=/api/v1

# ── Database (required) ───────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/lc_connect_db

# ── Supabase Auth — FastAPI verifies mobile tokens (required) ───────
# Project URL — Dashboard → Project Settings → API → Project URL
SUPABASE_URL=https://YOURPROJECT.supabase.co

# JWT secret — Dashboard → Project Settings → API → JWT Secret
# Required for local Supabase / HS256 tokens. Production RS256 can use JWKS from SUPABASE_URL alone.
SUPABASE_JWT_SECRET=

# Almost always leave as "authenticated" (Supabase default access-token audience)
SUPABASE_JWT_AUDIENCE=authenticated

# Campus signup policy (comma-separated domains)
ALLOWED_EMAIL_DOMAINS=students.livingstone.edu,livingstone.edu

# Development/testing only — non-Livingstone emails allowed to sign in locally.
# Must be empty in production (app refuses to start if set when ENVIRONMENT=production).
DEV_TEST_EMAILS=cephas.bonsuosei@gmail.com,asiedudev.hub@gmail.com,asieduminta27@gmail.com,auralenx.team@gmail.com,bdoreen889@gmail.com
DEV_TEST_EMAIL_DEFAULT_ROLE=student

# ── Legacy custom auth (rollback window only) ─────────────────────
# Set false after all clients use Supabase Auth. JWT_SECRET_KEY only needed while true.
AUTH_LEGACY_ENABLED=false  # off post-migration (app uses Supabase Auth); true only for emergency rollback
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

CORS_ORIGINS=http://localhost:3000,http://localhost:8081,http://127.0.0.1:3000,http://127.0.0.1:8081

# ── Supabase Storage (profile images — not required for login) ──────
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PROFILE_BUCKET=profile-images
MAX_PROFILE_IMAGE_MB=5
MAX_REQUEST_BODY_MB=12  # hard cap on any request body (≥ image cap; rejects oversized uploads at the edge)

# ── Limits & per-user abuse rate limits ───────────────────────────
# Global hard cap on group members (a group can never exceed this).
GROUP_MAX_MEMBERS=500
# Per-user, per-day caps on authenticated actions (login limits live in Supabase Auth).
RATE_LIMIT_CONNECTION_REQUESTS_PER_DAY=50
RATE_LIMIT_GROUP_CREATES_PER_DAY=5
RATE_LIMIT_AVATAR_UPLOADS_PER_DAY=10
RATE_LIMIT_REPORTS_PER_DAY=20
RATE_LIMIT_GROUP_INVITES_PER_DAY=200

# Verified staff may author campus posts (updates/opportunities). Admins always can.
# Urgent alerts remain admin-only regardless of this flag.
STAFF_PUBLISHING_ENABLED=true

# Verified staff may message any active user without a connection (and be messaged back).
STAFF_MESSAGING_ENABLED=true
RATE_LIMIT_STAFF_THREADS_PER_DAY=200
RATE_LIMIT_RECIPIENT_SEARCHES_PER_MINUTE=60
RATE_LIMIT_CAMPUS_POST_CREATES_PER_DAY=30
RATE_LIMIT_CAMPUS_POST_PUBLISHES_PER_DAY=20

# ── Email (Supabase sends auth emails; these are for legacy OTP only) ─
EMAIL_PROVIDER=auto
RESEND_API_KEY=
RESEND_FROM_EMAIL=LC Connect <noreply@yourdomain.com>
RESEND_REPLY_TO=support@yourdomain.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=LC Connect <your-gmail@gmail.com>
SMTP_TLS=true
