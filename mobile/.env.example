# ── API (required) ────────────────────────────────────────────────
# Must include the /api/v1 suffix. The WebSocket URL is derived from this
# (http→ws, https→wss), so a production https value also upgrades realtime to wss.
#
# Production (Render):
# API_BASE_URL=https://lc-connect-api-571f.onrender.com/api/v1
#
# Local — iOS simulator / web (Android emulator rewrites localhost to 10.0.2.2 automatically):
API_BASE_URL=http://localhost:8000/api/v1

# ── Supabase Auth — Flutter signs in here (required) ──────────────
# Dashboard → Project Settings → API → Project URL
SUPABASE_URL=https://YOURPROJECT.supabase.co

# Dashboard → Project Settings → API → anon / public key (safe in the app)
SUPABASE_ANON_KEY=

ENV=development
